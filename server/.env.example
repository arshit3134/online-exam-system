# ---- Server ----
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or local mongodb://127.0.0.1:27017/exam-system)
MONGODB_URI=mongodb://127.0.0.1:27017/exam-system

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_DAYS=7

# Allowed browser origin(s) for CORS, comma separated. No trailing slash.
CLIENT_URL=http://localhost:5173

# Cookie SameSite policy. Defaults: development=lax, production=none (needed when the
# frontend and API live on different domains). Use "lax" if you proxy /api through the frontend domain.
# COOKIE_SAME_SITE=none

# Grace period (seconds) after the timer hits zero during which a final submit is still accepted
SUBMIT_GRACE_SECONDS=15

# Optional: create the first teacher on boot if no user with this email exists.
# Remove these after the first successful boot.
# SEED_TEACHER_NAME=Admin Teacher
# SEED_TEACHER_EMAIL=teacher@example.com
# SEED_TEACHER_PASSWORD=ChangeMe123!
